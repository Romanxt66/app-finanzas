<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema mientras arranca el proceso (hasta el primer fotograma de Flutter). AppCompat: lo exige
         el diálogo de huella en Android 8 o anterior. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema detrás de la interfaz de Flutter mientras la app está abierta -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/alvea_launch</item>
    </style>
</resources>
