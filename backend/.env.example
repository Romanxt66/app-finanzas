# Cadena de conexión SQLAlchemy async, p. ej. postgresql+asyncpg://usuario:clave@host:5432/nombre
DATABASE_URL=
# Mínimo 32 caracteres aleatorios (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Lista JSON, p. ej. ["http://localhost:5173"]
CORS_ORIGINS=[]
ENVIRONMENT=development
